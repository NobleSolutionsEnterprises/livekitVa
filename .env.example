# Database
DATABASE_URL=postgresql://user:password@localhost:5432/va_platform

# Redis (local dev — single instance)
REDIS_URL=redis://localhost:6379
# Production Redis Sentinel (comma-separated host:port pairs)
# REDIS_SENTINELS=sentinel1:26379,sentinel2:26379,sentinel3:26379
# REDIS_MASTER_NAME=mymaster

# JWT
JWT_SECRET=change-me-in-production

# OpenAI
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Telnyx
TELNYX_API_KEY=KEY...
TELNYX_WEBHOOK_SECRET=...
TELNYX_SIP_CONNECTION_ID=...

# LiveKit
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=...
LIVEKIT_API_SECRET=...

# Google OAuth (Calendar)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/businesses/{id}/calendar/callback

# Encryption (pgcrypto symmetric key for OAuth tokens)
ENCRYPTION_KEY=change-me-32-chars-minimum-length
# NEW_ENCRYPTION_KEY=  # set only during key rotation

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=va-platform
