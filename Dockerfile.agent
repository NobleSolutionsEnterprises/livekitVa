FROM python:3.12-slim

RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.agent.txt .
RUN pip install --no-cache-dir -r requirements.agent.txt

COPY . .

ENV PYTHONPATH=/app

CMD ["python", "-m", "agent.main", "start"]
